---
import Layout from '~/layouts/PageLayout.astro';
import Signup from '~/components/events/Signup.astro';
import FormattedDate from '~/components/events/FormattedDate.astro';
import EventAddress from '~/components/events/EventAddress.astro';
import Button from '~/components/ui/Button.astro';

import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
  };
  date: Date;
  endDate?: Date;
  allDay?: boolean;
  location: string[];
  locationUrl?: string;
  imgsrc: string;
  imgalt: string;
  posterImage?: { src: string; alt: string };
  url?: string;
  urlButtonLabel?: string;
  data_luma_event_id?: string;
  cost?: number;
  partnerEvent?: boolean;
  partnerOrganization?: string;
  slug?: string;
  series?: string;
  seriesPart?: number;
  seriesTotal?: number;
}

const {
  frontmatter,
  date,
  endDate,
  allDay,
  location,
  locationUrl,
  url,
  urlButtonLabel,
  data_luma_event_id,
  imgsrc,
  imgalt,
  posterImage,
  cost,
  partnerEvent = false,
  partnerOrganization,
  slug,
  series,
  seriesPart,
  seriesTotal,
} = Astro.props;

// Using template literals
const imgcss = `h-72 w-full object-contain`;

const metadata: MetaData = {
  title: frontmatter.title,
};

// if no title, use "New Event"
const title = frontmatter.title ?? 'New Event';

// Breaking Title After Colon or Dash

// Find the first colon or dash
const colonIndex = title.indexOf(':');
const dashIndex = title.indexOf('-');

// Choose the earliest one (if either exists)
const breakIndex = [colonIndex, dashIndex].filter((i) => i !== -1).sort((a, b) => a - b)[0];

const hasBreak = breakIndex !== undefined;
const firstLine = hasBreak ? title.slice(0, breakIndex + 1) : title;
const secondLine = hasBreak ? title.slice(breakIndex + 1).trim() : '';

const Wrap = posterImage ? 'div' : Fragment;
const Column = posterImage ? 'div' : Fragment;
const headerClass = posterImage ? '-mx-1' : 'px-4 py-4 sm:px-6 mx-auto lg:px-8 max-w-4xl';
const sectionClass = posterImage
  ? `px-4 py-8 sm:px-6 mx-auto lg:px-8 max-w-6xl ${partnerEvent ? 'mb-16' : ''}`
  : `px-4 py-8 sm:px-6 mx-auto lg:px-8 max-w-4xl ${partnerEvent ? 'mb-16' : ''}`;
---

<Layout metadata={metadata}>
  {
    /* With a posterImage, the poster replaces the header image and takes the left half (stacked on top on
      mobile) with the event details to its right; the description runs full width below both. Without one,
      Wrap/Column render as Fragments, so the page is unchanged. */
  }
  <Wrap
    {...posterImage ? { class: 'px-4 py-4 sm:px-6 lg:px-8 mx-auto max-w-6xl md:flex md:items-start md:gap-10' } : {}}
  >
    {
      posterImage && (
        <div class="mb-6 md:mb-0 md:w-1/2 md:flex-shrink-0">
          <img src={posterImage.src} alt={posterImage.alt} class="w-full h-auto rounded-xl shadow-md" />
        </div>
      )
    }
    <Column {...posterImage ? { class: 'min-w-0 md:flex-1' } : {}}>
      <div class={headerClass}>
        <div class={`grid grid-cols-1 gap-2 ${posterImage ? '' : 'md:grid-cols-2'}`}>
          {!posterImage && <img src={imgsrc} alt={imgalt} class={imgcss} />}
          <div class="p-1">
            {
              series && seriesPart && seriesTotal && (
                <div class="mb-1 inline-block rounded-full bg-blue-50 px-3 py-1 text-xs font-bold uppercase tracking-wide text-primary dark:bg-slate-800 dark:text-blue-300">
                  {series} · Part {seriesPart} of {seriesTotal}
                </div>
              )
            }
            <h2
              class="text-2xl font-bold mb-2 font-heading leading-tighter tracking-tighter text-gray-900 dark:text-slate-100"
            >
              {firstLine}
              {secondLine && <br />}
              {secondLine}
            </h2>
            {
              partnerEvent && partnerOrganization && (
                <div class="text-base mb-3 text-gray-600 dark:text-gray-400 italic">
                  Hosted by {partnerOrganization}
                </div>
              )
            }
            <div class="text-lg mb-4 text-gray-700 dark:text-slate-300">
              <FormattedDate date={date} endDate={endDate} allDay={allDay} />
            </div>
            <div class="text-lg mb-4 text-gray-700 dark:text-slate-300">
              <EventAddress artists={location || []} url={locationUrl} />
            </div>
            {
              cost !== undefined && (
                <div class="text-lg font-semibold mb-4 text-gray-900 dark:text-slate-100">
                  Ticket Cost: ${cost.toFixed(2)}
                </div>
              )
            }
            {
              (endDate || date) < new Date(new Date().toLocaleString('en-US', { timeZone: 'America/New_York' })) ? (
                ' '
              ) : (
                <Signup url={url} urlButtonLabel={urlButtonLabel} data_luma_event_id={data_luma_event_id} slug={slug} />
              )
            }
          </div>
        </div>
      </div>
    </Column>
  </Wrap>

  <section class={sectionClass}>
    <div
      class="prose prose-lg dark:prose-invert max-w-none
  prose-h1:font-bold prose-h1:text-xl
  prose-h2:font-semibold prose-h2:text-2xl
  prose-h3:font-semibold prose-h3:text-lg
 prose-a:underline prose-a:text-blue-600 hover:prose-a:text-blue-800 dark:prose-a:text-blue-300 dark:hover:prose-a:text-blue-200
  prose-p:text-left sm:prose-p:text-justify prose-img:rounded-xl
  prose-headings:no-underline"
    >
      <slot />
    </div>
  </section>
  {
    !partnerEvent && (
      <section class="px-4 py-8 sm:px-6 mx-auto lg:px-8 max-w-4xl">
        <h2 class="font-semibold mb-4 text-2xl font-heading leading-tighter tracking-tighter text-gray-900 dark:text-slate-100">
          Code of Conduct:
        </h2>
        <div class="prose prose-lg dark:prose-invert max-w-none prose-a:underline prose-a:text-blue-600 hover:prose-a:text-blue-800 dark:prose-a:text-blue-300 dark:hover:prose-a:text-blue-200 prose-p:text-left sm:prose-p:text-justify">
          <p>
            This event is dedicated to providing a harassment-free experience for everyone, regardless of gender, gender
            identity and expression, age, sexual orientation, disability, physical appearance, body size, race,
            ethnicity, religion (or lack thereof), or technology choices. We do not tolerate harassment in any form.
            Anyone violating these rules may be sanctioned or banned from attending at the discretion of the conference
            organizers. Please contact the organizers through lu.ma messaging/Slack, if you feel someone has broken the
            code of conduct.
          </p>
          <p class="text-sm">
            Original source and credit:
            <a href="http://2012.jsconf.us/#/about">http://2012.jsconf.us/#/about</a> &
            <a href="http://geekfeminism.wikia.com/wiki/Conference_anti-harassment/Policy">The Ada Initiative</a>
          </p>
        </div>
      </section>
    )
  }

  <div class="text-center px-4 py-8 sm:px-6 mx-auto lg:px-8 max-w-4xl">
    <Button variant="secondary" href="/events" text="Return to Events" />
  </div>
</Layout>
