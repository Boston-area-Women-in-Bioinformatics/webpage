---
// Closing CTA box (e.g. Get Involved) for a newsletter issue: bordered pastel
// box, centered text, ending in a btn-primary button. `html` is raw HTML (may
// include an <a> link) rendered via set:html — see HighlightBox for why
// content is passed as a prop rather than JSX children. `heading` is optional
// — pass it to move the section's `##` heading inside the box itself (as this
// component lives in a `not-prose` context, its size/weight/color are set
// explicitly here to match a real prose `##` heading elsewhere on the same
// page: SinglePost.astro's `prose-lg lg:prose-xl` renders h2 at 30px, scaling
// to 36px at the `lg:` breakpoint (i.e. text-3xl lg:text-4xl), with prose's
// forced font-weight 700, `tracking-tighter`, and heading color (gray-900
// light / the layout's `dark:prose-headings:text-slate-300` dark).
export interface Props {
  heading?: string;
  html: string;
  buttonHref: string;
  buttonLabel: string;
}

const { heading, html, buttonHref, buttonLabel } = Astro.props;
---

<div
  class="not-prose my-4 rounded-lg border border-blue-200 bg-blue-50 p-6 text-center dark:border-slate-700 dark:bg-slate-800"
>
  {
    heading && (
      <h2 class="font-heading mb-3 text-3xl font-bold tracking-tighter text-gray-900 dark:text-slate-300 lg:text-4xl">
        {heading}
      </h2>
    )
  }
  <p class="mb-3 text-slate-800 dark:text-slate-100" set:html={html} />
  <a href={buttonHref} class="btn-primary not-prose mt-2">
    {buttonLabel}
  </a>
</div>
