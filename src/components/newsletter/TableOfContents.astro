---
// Renders the "Here's what's inside this month" styled TOC box for a
// newsletter issue. Pass one { href, label } entry per `##` section anchor,
// in the order the sections appear (see edit-newsletter skill).
export interface Props {
  items: Array<{ href: string; label: string }>;
  title?: string;
}

const { items, title = "Here's what's inside this month" } = Astro.props;
---

<div class="not-prose rounded-lg border-l-4 border-teal-600 bg-teal-50 p-5 dark:bg-slate-800">
  <p class="mb-3 text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-500">{title}</p>
  <ul class="m-0 list-none space-y-1.5 pl-0">
    {
      items.map((item) => (
        <li>
          <a href={item.href} class="text-slate-600 hover:underline dark:text-slate-300">
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>
