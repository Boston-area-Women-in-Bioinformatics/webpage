---
// Blog post preview card for a newsletter issue's Blog Bytes section: cover
// image on the left (stacked on top on mobile, cropped with object-cover so it
// fills the card height instead of leaving empty space beside short text),
// then an optional eyebrow (series/category), linked title, byline, blurb, and
// a "Read the post →" link. `html` is raw HTML (may include an <a> link)
// rendered via set:html — see HighlightBox for why content is passed as a prop
// rather than JSX children.
export interface Props {
  href: string;
  image: string;
  imageAlt: string;
  title: string;
  eyebrow?: string;
  author?: string;
  authorUrl?: string;
  html: string;
  ctaLabel?: string;
}

const { href, image, imageAlt, title, eyebrow, author, authorUrl, html, ctaLabel = 'Read the post' } = Astro.props;
---

<div
  class="not-prose my-6 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition hover:shadow-md dark:border-slate-700 dark:bg-slate-800 sm:flex"
>
  <a href={href} class="block sm:w-2/5 sm:flex-shrink-0">
    <img src={image} alt={imageAlt} class="aspect-video h-full w-full object-cover" loading="lazy" />
  </a>
  <div class="flex flex-col p-5 sm:p-6">
    {
      eyebrow && (
        <p class="mb-1 text-sm font-semibold uppercase tracking-wide text-primary dark:text-blue-300">{eyebrow}</p>
      )
    }
    <h3 class="font-heading text-xl font-bold leading-snug text-gray-900 dark:text-slate-100 lg:text-2xl">
      <a href={href} class="hover:underline">{title}</a>
    </h3>
    {
      author && (
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          By{' '}
          {authorUrl ? (
            <a href={authorUrl} class="hover:underline">
              {author}
            </a>
          ) : (
            author
          )}
        </p>
      )
    }
    <p class="mt-3 text-base text-slate-800 dark:text-slate-200" set:html={html} />
    <a href={href} class="mt-4 font-semibold text-primary hover:underline dark:text-blue-300">
      {ctaLabel} &rarr;
    </a>
  </div>
</div>
