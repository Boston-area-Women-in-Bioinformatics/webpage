---
// Short highlighted note (e.g. a student discount, a deadline reminder) for a
// newsletter issue. `html` is raw HTML (may include an <a> link) rendered via
// set:html — passing content as a prop rather than JSX children avoids MDX's
// remark parser splitting multi-line JSX children into stray/empty <p> tags.
// On the newsletter email route it renders an inline-styled table instead (see
// src/utils/newsletterEmail.ts).
import { EMAIL, isNewsletterEmailRender } from '~/utils/newsletterEmail';

export interface Props {
  tone?: 'warm' | 'primary';
  html: string;
}

const { tone = 'warm', html } = Astro.props;
const isEmail = isNewsletterEmailRender(Astro.url);

const toneClasses = {
  warm: 'border-accent-warm bg-orange-50',
  primary: 'border-primary bg-blue-50',
};

const emailTone = {
  warm: { border: EMAIL.accentWarm, bg: EMAIL.orange50 },
  primary: { border: EMAIL.primary, bg: EMAIL.blue50 },
}[tone];
---

{
  isEmail ? (
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style={`border-collapse:collapse;background-color:${emailTone.bg};border-left:4px solid ${emailTone.border};margin:16px 0;`}
    >
      <tr>
        <td style={`padding:16px;font-family:${EMAIL.font};font-size:16px;line-height:1.6;color:${EMAIL.text};`}>
          <p style="margin:0;" set:html={html} />
        </td>
      </tr>
    </table>
  ) : (
    <div class={`not-prose my-4 rounded-lg border-l-4 p-4 dark:bg-slate-800 ${toneClasses[tone]}`}>
      <p class="m-0 text-md text-slate-800 dark:text-slate-200" set:html={html} />
    </div>
  )
}
