---
import { Icon } from 'astro-icon/components';

interface Props {
  artists: string[];
  /** Optional link (e.g. venue or directions page); wraps the whole address when set. */
  url?: string;
}

const { artists, url } = Astro.props;
const address = artists.join(', ');
---

{
  url ? (
    <a href={url} target="_blank" rel="noopener noreferrer" class="text-primary dark:text-blue-300 hover:underline">
      <Icon name="tabler:map-pin" class="w-4 h-4 inline-block -mt-0.5 mr-0.5" />
      {address}
    </a>
  ) : (
    <>{address} </>
  )
}
