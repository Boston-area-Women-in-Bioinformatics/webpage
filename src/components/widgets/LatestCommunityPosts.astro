---
import { getCollection } from 'astro:content';
import { APP_BLOG } from 'astrowind:config';

import Card from '~/components/ui/Card.astro';
import NewBadge from '~/components/ui/NewBadge.astro';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import { findLatestPosts } from '~/utils/blog';
import { getBlogPermalink } from '~/utils/permalinks';

// Rainbow colors from the WIB logo (matches Team.astro / CommitteeGrid.astro)
const rainbowColors = [
  'bg-purple-500', // purple
  'bg-pink-500', // pink
  'bg-orange-500', // orange
  'bg-yellow-500', // yellow
  'bg-green-500', // green
  'bg-sky-500', // blue
];

export interface Props {
  title?: string;
  subtitle?: string;
  count?: number;
  showHeading?: boolean;
  showViewAllButton?: boolean;
  /** 'grid' shows all posts at once (homepage default); 'carousel' auto-advances through one post at a time */
  variant?: 'grid' | 'carousel';
}

const {
  title = 'Latest from Our Community',
  subtitle = 'Dive into the latest blogs, videos, and conversations from our members',
  count = 4,
  showHeading = true,
  showViewAllButton = true,
  variant = 'grid',
} = Astro.props;

const allLatestPosts = APP_BLOG.isEnabled ? (await findLatestPosts({ count: 20 })) || [] : [];
const nonPodcastPosts = allLatestPosts.filter((p) => p.category?.slug !== 'podcast');

// Build a map of series slug → series image/alt from the series collection
const seriesEntries = await getCollection('series');
const seriesImageMap = new Map<string, { image?: string; imageAlt?: string; imageFit?: string }>();
seriesEntries.forEach((entry) => {
  const slug = entry.id.replace(/\.md$/, '');
  seriesImageMap.set(slug, { image: entry.data.image, imageAlt: entry.data.imageAlt, imageFit: entry.data.imageFit });
});

// Build a map of series slug → 2 most recent posts
const seriesPostsMap = new Map<string, typeof nonPodcastPosts>();
nonPodcastPosts.forEach((p) => {
  if (p.series?.slug) {
    const existing = seriesPostsMap.get(p.series.slug) ?? [];
    if (existing.length < 2) seriesPostsMap.set(p.series.slug, [...existing, p]);
  }
});

const seenSeries = new Set<string>();
const latestMediaPosts = nonPodcastPosts
  .filter((p) => {
    if (p.series?.slug) {
      if (seenSeries.has(p.series.slug)) return false;
      seenSeries.add(p.series.slug);
    }
    return true;
  })
  .slice(0, count);

const thirtyDaysAgo = new Date();
thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);

function getPostCardData(post: (typeof latestMediaPosts)[number]) {
  const seriesMeta = post.series?.slug ? seriesImageMap.get(post.series.slug) : undefined;
  const cardImage = seriesMeta?.image ?? post.image;
  const cardImageAlt = seriesMeta?.imageAlt ?? post.imageAlt;
  const cardImageFit = post.imagePosition === 'contain' ? 'contain' : (seriesMeta?.imageFit ?? 'cover');
  const objectPosition = post.imagePosition === 'top' ? 'top' : post.imagePosition === 'bottom' ? 'bottom' : 'center';
  const isRemoteImage =
    typeof cardImage === 'string' &&
    (cardImage.startsWith('http') || cardImage.startsWith('/assets/') || cardImage.startsWith('/blog_images/'));
  const isNew = new Date(post.publishDate) >= thirtyDaysAgo;
  const href = post.series ? `/series/${post.series.slug}` : post.permalink;

  return { cardImage, cardImageAlt, cardImageFit, objectPosition, isRemoteImage, isNew, href };
}

// Elements are targeted by id from the client script below, so ids must be
// unique per instance (see ImessageChat.astro for the same pattern).
const instanceId = `carousel-${Math.random().toString(36).slice(2, 9)}`;
---

{
  APP_BLOG.isEnabled && (
    <>
      {showHeading && (
        <>
          <h2 class="text-3xl font-bold tracking-tight sm:text-4xl mb-4 text-center">{title}</h2>
          <p class="text-center text-gray-500 dark:text-gray-400 mb-8">{subtitle}</p>
        </>
      )}
      {variant === 'grid' ? (
        <div class="grid grid-cols-2 gap-6">
          {latestMediaPosts.map((post) => {
            const { cardImage, cardImageAlt, cardImageFit, objectPosition, isRemoteImage, isNew, href } =
              getPostCardData(post);
            return (
              <div class="relative">
                {isNew && <NewBadge />}
                <Card variant="blog" padding="p-0">
                  {cardImage && (
                    <a href={href} class="block">
                      {isRemoteImage ? (
                        <img
                          src={cardImage}
                          alt={cardImageAlt}
                          class={`w-full h-48 object-${cardImageFit}`}
                          style={`object-position: ${objectPosition};`}
                          loading="lazy"
                        />
                      ) : (
                        <Image
                          src={cardImage}
                          alt={cardImageAlt || post.title || 'Post image'}
                          class={`w-full h-48 object-${cardImageFit}`}
                          style={`object-position: ${objectPosition};`}
                          widths={[400, 600]}
                          width={600}
                          height={400}
                          sizes="(max-width: 768px) 50vw, 50vw"
                          loading="lazy"
                        />
                      )}
                    </a>
                  )}
                  <div class="p-3">
                    {post.series ? (
                      <>
                        <span class="inline-block text-xs font-semibold text-primary dark:text-blue-400 uppercase tracking-wide mb-1">
                          Series: {post.series.title}
                        </span>
                        <ul class="mt-1 space-y-1">
                          {(seriesPostsMap.get(post.series.slug) ?? []).map((sp) => (
                            <li class="text-xs">
                              <a
                                href={sp.permalink}
                                class="font-semibold hover:text-primary dark:hover:text-blue-400 transition ease-in duration-200"
                              >
                                {sp.title}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </>
                    ) : (
                      <>
                        <h4 class="text-sm font-bold leading-tight mb-1">
                          <a
                            href={post.permalink}
                            class="hover:text-primary dark:hover:text-blue-700 transition ease-in duration-200"
                          >
                            {post.title}
                          </a>
                        </h4>
                        {post.excerpt && (
                          <p class="text-muted dark:text-slate-300 text-xs line-clamp-2">{post.excerpt}</p>
                        )}
                      </>
                    )}
                  </div>
                </Card>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="relative max-w-2xl mx-auto" id={`${instanceId}-carousel`}>
          <div class="overflow-hidden rounded-lg shadow-md">
            <div id={`${instanceId}-track`} class="flex transition-transform duration-500 ease-in-out">
              {latestMediaPosts.map((post) => {
                const { cardImage, cardImageAlt, cardImageFit, objectPosition, isRemoteImage, isNew, href } =
                  getPostCardData(post);
                return (
                  <a href={href} class="relative block w-full flex-shrink-0 bg-white dark:bg-slate-700">
                    {isNew && <NewBadge />}
                    {cardImage &&
                      (isRemoteImage ? (
                        <img
                          src={cardImage}
                          alt={cardImageAlt}
                          class={`w-full h-64 sm:h-80 object-${cardImageFit}`}
                          style={`object-position: ${objectPosition};`}
                          loading="lazy"
                        />
                      ) : (
                        <Image
                          src={cardImage}
                          alt={cardImageAlt || post.title || 'Post image'}
                          class={`w-full h-64 sm:h-80 object-${cardImageFit}`}
                          style={`object-position: ${objectPosition};`}
                          widths={[400, 800]}
                          width={800}
                          height={500}
                          sizes="(max-width: 768px) 100vw, 672px"
                          loading="lazy"
                        />
                      ))}
                    <div class="p-4 text-center">
                      {post.series ? (
                        <span class="inline-block text-xs font-semibold text-primary dark:text-blue-400 uppercase tracking-wide">
                          Series: {post.series.title}
                        </span>
                      ) : (
                        <h4 class="text-lg font-bold leading-tight">{post.title}</h4>
                      )}
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
          {latestMediaPosts.length > 1 && (
            <>
              <button
                type="button"
                id={`${instanceId}-prev`}
                aria-label="Previous post"
                class="absolute left-2 top-1/2 z-10 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 shadow-md transition-colors hover:bg-white dark:bg-slate-800/90 dark:hover:bg-slate-800"
              >
                <svg
                  class="h-5 w-5 text-gray-700 dark:text-slate-200"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
              </button>
              <button
                type="button"
                id={`${instanceId}-next`}
                aria-label="Next post"
                class="absolute right-2 top-1/2 z-10 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 shadow-md transition-colors hover:bg-white dark:bg-slate-800/90 dark:hover:bg-slate-800"
              >
                <svg
                  class="h-5 w-5 text-gray-700 dark:text-slate-200"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </button>
              <div class="mt-4 flex justify-center gap-2">
                {latestMediaPosts.map((post, i) => (
                  <button
                    type="button"
                    class={`carousel-dot h-2.5 w-2.5 rounded-full ring-offset-2 transition-all dark:ring-offset-[var(--aw-color-bg-page-dark)] ${rainbowColors[i % rainbowColors.length]} ${i === 0 ? 'scale-125 opacity-100 ring-2 ring-gray-700 dark:ring-white' : 'opacity-40'}`}
                    data-index={i}
                    aria-label={`Show post ${i + 1}: ${post.title}`}
                  />
                ))}
              </div>
            </>
          )}
        </div>
      )}
      {showViewAllButton && (
        <div class="text-center mt-6">
          <Button variant="link" href={getBlogPermalink()}>
            View all posts »
          </Button>
        </div>
      )}
    </>
  )
}

<script define:vars={{ instanceId }} is:inline>
  (function () {
    const carousel = document.getElementById(`${instanceId}-carousel`);
    const track = document.getElementById(`${instanceId}-track`);
    if (!carousel || !track) return;

    const dots = Array.from(carousel.querySelectorAll('.carousel-dot'));
    const slideCount = dots.length;
    if (slideCount <= 1) return;

    let index = 0;
    let timer = null;

    function render() {
      track.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach((dot, i) => {
        dot.classList.toggle('scale-125', i === index);
        dot.classList.toggle('opacity-100', i === index);
        dot.classList.toggle('ring-2', i === index);
        dot.classList.toggle('ring-gray-700', i === index);
        dot.classList.toggle('dark:ring-white', i === index);
        dot.classList.toggle('opacity-40', i !== index);
      });
    }

    function goTo(i) {
      index = (i + slideCount) % slideCount;
      render();
    }

    function startAutoAdvance() {
      stopAutoAdvance();
      timer = setInterval(() => goTo(index + 1), 5000);
    }

    function stopAutoAdvance() {
      if (timer) clearInterval(timer);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        goTo(Number(dot.dataset.index));
        startAutoAdvance();
      });
    });

    const prevBtn = document.getElementById(`${instanceId}-prev`);
    const nextBtn = document.getElementById(`${instanceId}-next`);
    prevBtn?.addEventListener('click', () => {
      goTo(index - 1);
      startAutoAdvance();
    });
    nextBtn?.addEventListener('click', () => {
      goTo(index + 1);
      startAutoAdvance();
    });

    carousel.addEventListener('mouseenter', stopAutoAdvance);
    carousel.addEventListener('mouseleave', startAutoAdvance);
    carousel.addEventListener('focusin', stopAutoAdvance);
    carousel.addEventListener('focusout', startAutoAdvance);

    render();
    startAutoAdvance();
  })();
</script>
